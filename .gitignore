# ============================================================
#  Данные и обученные модели: НИКОГДА не коммитим
#  (датасет организаторов, собранные документы, артефакты)
# ============================================================
# Лесенка, а не просто data/: git не заходит внутрь исключённого каталога,
# поэтому отрицание для файла внутри него не сработало бы. Наружу пускаем только
# technologies.csv — таблицу технологий, на которой обучается модель.
data/*
!data/interim/
data/interim/*
artifacts/
*.xlsx
*.xls
*.csv
*.parquet
*.pkl
*.joblib
*.cbm
catboost_info/

# Разметка (ручные лейблы) — версионируем, это не сырые данные
!labels/*.csv
# Таблица технологий, на которой обучается модель. Стоит здесь, а не в лесенке
# выше: в .gitignore побеждает последнее совпавшее правило, и *.csv перебило бы.
!data/interim/technologies.csv

# ============================================================
#  Секреты: пароли и ключи API только в .env
#  Шаблон ..env.example коммитим (без реальных значений)
# ============================================================
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ============================================================
#  Jupyter
# ============================================================
.ipynb_checkpoints/

# ============================================================
#  IDE и операционные системы
# ============================================================
.idea/
.vscode/
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
#  Логи и временные файлы
# ============================================================
*.log
tmp/

# ============================================================
#  Рабочие планы по задачам: не коммитим
# ============================================================
*-plan.md
