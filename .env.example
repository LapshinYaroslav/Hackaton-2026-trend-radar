# Шаблон переменных окружения (без секретов).
# Скопируй: cp .env.example .env
# Реальный .env в git не коммитим.

POSTGRES_USER=trend
POSTGRES_PASSWORD=trend
POSTGRES_DB=trend_radar

# Из контейнера ui к api — по имени сервиса:
DATABASE_URL=postgresql://trend:trend@db:5432/trend_radar
API_URL=http://api:8000

# Если запускаешь Streamlit локально (не в Docker), API на хосте:
# API_URL=http://localhost:8000
# или оставь пустым — UI возьмёт пример ответа docs/contracts/query_result.example.json

# --- YandexGPT (подзапросы, извлечение кандидатов — шаг 4, перевод названий) ---
# Ключи только в .env, не в git.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# Модель подзапросов (yandexgpt — это YandexGPT Pro 5). Шаг 4 и перевод названий
# вызывают yandexgpt-5-pro явно, эта переменная на них не влияет.
YANDEX_GPT_MODEL=yandexgpt

# --- Роспатент (патентный признак share_patent боевой модели s2a2-v1) ---
# Ключ API поисковой платформы Роспатента https://searchplatform.rospatent.gov.ru
# (командный ключ — у Ярослава). Без ключа пайплайн работает, но share_patent у всех
# кандидатов недоступен: модель подставит медиану обучения, прогон будет помечен.
ROSPATENT=
